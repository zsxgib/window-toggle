#!/snap/gnome-46-2404/153/usr/bin/python3.12
# window-toggle-viewer - GTK4 viewer for all configured bindings.
# Triggered by Ctrl+Pause (registered to dconf at meson install time).
# Read-only: displays app + slot bindings as a row of icons, with key and
# app name as captions. No interaction beyond Esc/close to dismiss.

import os
import signal
import subprocess
import sys
import configparser

try:
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('Adw', '1')
    from gi.repository import Gtk, Adw, Gdk, GdkPixbuf, GLib
except (ImportError, ValueError) as e:
    sys.stderr.write(
        "window-toggle-viewer: PyGObject + GTK4 + libadwaita not available.\n"
        "Install with: sudo apt install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1\n"
        f"Underlying error: {e}\n"
    )
    sys.exit(1)

WT_BIN = "/usr/local/bin/window-toggle"
ICON_SIZE = 96


def _mouse_position():
    """Read mouse position via xdotool. Returns (x, y) in root coords, or None."""
    try:
        r = subprocess.run(
            ["xdotool", "getmouselocation", "--shell"],
            capture_output=True, text=True, timeout=1,
        )
        if r.returncode != 0:
            return None
        x = y = 0
        for line in r.stdout.splitlines():
            if line.startswith("X="):
                x = int(line[2:])
            elif line.startswith("Y="):
                y = int(line[2:])
        return (x, y)
    except Exception:
        return None


def _monitor_at_mouse(display):
    """Return the Gdk.Monitor that currently contains the mouse pointer,
    or the primary monitor if the lookup fails.

    GTK4's Gdk.X11Display does not implement get_monitor_at_point in
    the Python bindings. We use xdotool for the mouse position (which
    returns physical pixels) and convert each monitor's geometry from
    logical to physical via its scale factor before comparing.
    """
    pos = _mouse_position()
    if pos is not None:
        mx, my = pos
        monitors = display.get_monitors()
        n = monitors.get_n_items()
        for i in range(n):
            m = monitors.get_item(i)
            try:
                g = m.get_geometry()
                scale = m.get_scale_factor() or 1
            except Exception:
                continue
            # Convert logical -> physical.
            px, py = g.x * scale, g.y * scale
            pw, ph = g.width * scale, g.height * scale
            if px <= mx < px + pw and py <= my < py + ph:
                return m
    return display.get_primary_monitor() or display.get_monitors().get_item(0)


def _center_window(win, width, height):
    """Place win at the center of the monitor where the mouse currently is.

    GTK4's monitor geometry is in scaled (logical) pixels, while xdotool
    expects physical pixel coordinates. We use Gdk.Monitor.get_scale_factor()
    to convert, then call xdotool to move the realized surface.
    """
    display = Gdk.Display.get_default()
    if not display:
        return
    monitor = _monitor_at_mouse(display)
    if monitor is None:
        return
    geo = monitor.get_geometry()
    scale = monitor.get_scale_factor() or 1.0
    cx = geo.x + max(0, (geo.width - width) // 2)
    cy = geo.y + max(0, (geo.height - height) // 2)
    px = int(cx * scale)
    py = int(cy * scale)

    win.set_default_size(width, height)
    win.set_size_request(width, height)

    # Re-read mouse position at call time, recompute center, then move.
    # The captured px/py from _center_window call are stale for the
    # second show; we re-derive from the current mouse each time.
    display = Gdk.Display.get_default()

    def _place():
        try:
            from gi.repository import GdkX11  # noqa
            surface = win.get_surface()
            if surface is None:
                return False
            if not isinstance(surface, GdkX11.X11Surface):
                return False
            xid = surface.get_xid()
            # Recompute target from current mouse position.
            mon = _monitor_at_mouse(display)
            if mon is not None:
                geo = mon.get_geometry()
                scale = mon.get_scale_factor() or 1.0
                tx = int((geo.x + max(0, (geo.width - width) // 2)) * scale)
                ty = int((geo.y + max(0, (geo.height - height) // 2)) * scale)
            else:
                tx, ty = px, py
            subprocess.Popen(["xdotool", "windowmove", hex(xid), str(tx), str(ty)])
        except Exception:
            pass
        return False
    GLib.idle_add(_place)
    GLib.timeout_add(100, _place)
    return _place
STATUS_NOT_STARTED = "not-started"
STATUS_STARTED = "started"
STATUS_HIDDEN = "hidden"

# Paths to the two config files. Tracked by a periodic mtime check so the
# viewer can pick up new bindings without being restarted.
APP_BINDINGS_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "window-toggle", "bindings.json",
)
SLOT_BINDINGS_PATH = "/tmp/window-toggle-config.json"
def _check_files_mtime():
    """Return a stable signature that changes whenever either config file is
    added, modified, or removed. We can't rely on a single mtime: if the
    slot file is deleted, its mtime slot would simply drop to 0 and look
    unchanged from the previous "no slot file" reading. Instead, we hash
    the (mtime_or_minus_1, size_or_minus_1) tuple of each file. -1 marks a
    missing file, so a delete flips its mtime/size from real values to
    -1/-1, which the comparison below will detect."""
    sigs = []
    for path in (APP_BINDINGS_PATH, SLOT_BINDINGS_PATH):
        try:
            st = os.stat(path)
            sigs.append((st.st_mtime, st.st_size))
        except OSError:
            sigs.append((-1, -1))
    return tuple(sigs)


def _make_separator():
    """Vertical bar used to separate app bindings from slot bindings in the
    viewer popup. 2px wide, 120px tall, with an 8px margin on each side so
    it does not touch adjacent items. Centered vertically inside the
    horizontal Box that holds the row of bindings."""
    sep = Gtk.Box()
    sep.set_size_request(4, 140)
    sep.set_valign(Gtk.Align.CENTER)
    sep.set_hexpand(False)
    sep.set_vexpand(False)
    sep.set_margin_start(10)
    sep.set_margin_end(10)
    sep.add_css_class("wt-sep")
    return sep


def _layout_into(box, items):
    """Clear the existing children of `box`, then append a freshly built
    widget for each entry in `items`. Inserts a thin vertical separator at
    the boundary between the "app" and "slot" sections. Returns
    (width, height) for the new layout."""
    while True:
        child = box.get_first_child()
        if child is None:
            break
        box.remove(child)
    prev_kind = None
    n_items = 0
    n_seps = 0
    for b in items:
        kind = b.get("kind", "")
        if prev_kind == "app" and kind == "slot":
            box.append(_make_separator())
            n_seps += 1
        box.append(build_binding_box(b))
        n_items += 1
        prev_kind = kind
    item_w = ICON_SIZE + 32
    # separator widget itself is 4px + 10+10 margins = 24px wide
    sep_w = 4 + 20
    width = n_items * item_w + n_seps * sep_w + 24
    height = ICON_SIZE + 72
    box.set_size_request(width, height)
    return width, height


def read_app_bindings():
    path = APP_BINDINGS_PATH
    if not os.path.exists(path):
        return []
    out = []
    cur = {}
    in_section = False
    with open(path) as f:
        for line in f:
            line = line.rstrip("\n")
            if line.strip() == "### app_bindings ###":
                in_section = True
                continue
            if not in_section:
                continue
            if not line.strip():
                if cur.get("key") and cur.get("cmd"):
                    out.append(cur)
                cur = {}
                continue
            if ":" in line:
                k, _, v = line.partition(":")
                cur[k.strip()] = v.strip()
    if cur.get("key") and cur.get("cmd"):
        out.append(cur)
    return out


def read_slot_bindings():
    path = SLOT_BINDINGS_PATH
    if not os.path.exists(path):
        return []
    out = []
    cur = {}
    with open(path) as f:
        for line in f:
            line = line.rstrip("\n")
            if not line.strip():
                if cur.get("key"):
                    out.append(cur)
                cur = {}
                continue
            if ":" in line:
                k, _, v = line.partition(":")
                cur[k.strip()] = v.strip()
    if cur.get("key"):
        out.append(cur)
    return out


def status_for(anchor_xid):
    """三态判定：窗口当前是开着的、被最小化藏起来的、还是已经彻底没了。

    之前只用两态（开 / 死），把"被最小化"和"anchor 死了"混为一谈，
    导致按 Ctrl+F9 把 terminator 关掉之后，viewer 这一行显示成
    [anchor: 0x..., dead]，让人误以为"窗口没关掉"。其实是被藏起来了。
    """
    if not anchor_xid or anchor_xid == 0:
        return STATUS_NOT_STARTED
    try:
        r = subprocess.run(
            ["xwininfo", "-id", hex(anchor_xid)],
            capture_output=True, text=True, timeout=2,
        )
        if r.returncode != 0:
            # xwininfo 找不到这个 XID → anchor 真的没了
            return STATUS_NOT_STARTED
        for line in r.stdout.splitlines():
            if "Map State:" in line:
                if "IsViewable" in line:
                    return STATUS_STARTED
                # IsUnmapped (被最小化) 或 IsUnviewable (被盖住但还显示)
                # 都算"被藏起来，按一下键能叫出来"
                return STATUS_HIDDEN
        return STATUS_NOT_STARTED
    except Exception:
        return STATUS_NOT_STARTED


def find_desktop_file(wm_class):
    if not wm_class:
        return None
    dirs = [
        "/usr/share/applications",
        os.path.expanduser("~/.local/share/applications"),
        "/var/lib/flatpak/exports/share/applications",
        os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
    ]
    for d in dirs:
        if not os.path.isdir(d):
            continue
        try:
            for name in os.listdir(d):
                if not name.endswith(".desktop"):
                    continue
                p = os.path.join(d, name)
                try:
                    cp = configparser.ConfigParser(strict=False)
                    cp.read(p)
                    swm = cp.get("Desktop Entry", "StartupWMClass", fallback="")
                    if swm and swm.lower() == wm_class.lower():
                        return p
                except Exception:
                    continue
        except OSError:
            continue
    return None


def icon_paintable_for(name, size=ICON_SIZE):
    """Return a Gdk.Texture for the given icon name, or None.

    GTK4 IconPaintable is a GdkPaintable but in the Yaru theme some
    app icons (notably the symbolic SVGs used for code / vscode /
    X-terminal-emulator) paint as missing-image when fed to Gtk.Image
    without a styling context. We side-step that by loading the icon's
    underlying file through GdkPixbuf (which decodes PNG/SVG into real
    pixels) and wrapping the result in a Gdk.Texture.
    """
    if not name:
        return None
    theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
    info = None
    try:
        info = theme.lookup_icon(name, None, size, 1, Gtk.TextDirection.LTR, Gtk.IconLookupFlags(0))
    except Exception:
        return None
    if not info:
        return None
    f = info.get_file()
    if f and f.get_path():
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_size(f.get_path(), size, size)
            return Gdk.Texture.new_for_pixbuf(pb)
        except Exception:
            pass
    # No backing file -> caller will keep trying other candidates.
    return None


# Backwards-compatible shim.
def icon_from_name(name, size=ICON_SIZE):
    return icon_paintable_for(name, size)


def icon_from_desktop_file(path, size=ICON_SIZE):
    if not path:
        return None
    try:
        cp = configparser.ConfigParser(strict=False)
        cp.read(path)
        icon_name = cp.get("Desktop Entry", "Icon", fallback="")
        if not icon_name:
            return None
        return icon_from_name(icon_name, size)
    except Exception:
        return None


def fallback_icon(size=ICON_SIZE):
    theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
    for name in ("application-x-executable", "system-run", "utilities-terminal"):
        try:
            info = theme.lookup_icon(name, None, size, 1, Gtk.TextDirection.LTR, Gtk.IconLookupFlags(0))
            if info:
                return info  # GTK4: info is the IconPaintable, no load_icon()
        except Exception:
            continue
    return None


# Some apps (notably Electron ones) name their desktop file differently
# from their wm_class and from their actual icon. These aliases map a
# wm_class (case-insensitive) to the canonical icon name in the system
# theme.
_ICON_ALIASES = {
    "code": "vscode",
    "code - insiders": "vscode-insiders",
    "code-insiders": "vscode-insiders",
    "spotify": "spotify-client",
}

# Some wm_class values are shared by many different apps (e.g.
# "X-terminal-emulator" is what gnome-terminal, terminator, konsole,
# xfce4-terminal, etc. all report), and the icon theme only ships icons
# for the specific app names, not for the generic class. When the direct
# lookup fails, try these specific names in order.
_WM_CLASS_ICON_FALLBACKS = {
    "X-terminal-emulator": [
        "terminator", "gnome-terminal", "konsole", "xfce4-terminal",
        "xfce-terminal", "tilix", "alacritty", "kitty", "foot",
        "sakura", "urxvt", "xterm", "st",
    ],
}


def lookup_icon_for(wm_class, app_name, size=ICON_SIZE):
    candidates = []
    if wm_class:
        candidates.append(wm_class)
        alias = _ICON_ALIASES.get(wm_class.lower())
        if alias:
            candidates.append(alias)
    if app_name:
        candidates.append(app_name)
        alias = _ICON_ALIASES.get(app_name.lower())
        if alias:
            candidates.append(alias)
    for name in candidates:
        pb = icon_from_name(name, size)
        if pb:
            return pb
    if wm_class:
        for name in _WM_CLASS_ICON_FALLBACKS.get(wm_class, []):
            pb = icon_from_name(name, size)
            if pb:
                return pb
    desktop = find_desktop_file(wm_class)
    if desktop:
        pb = icon_from_desktop_file(desktop, size)
        if pb:
            return pb
    return fallback_icon(size)


def build_shortcut_label(b):
    mod = b.get("modifiers", "")
    key = b.get("key", "")
    return f"{mod}+{key}" if mod else key


def _sort_key(b):
    """Return a tuple (kind_rank, modifier_count, f_number) used to sort
    bindings inside the viewer. App bindings come first (kind_rank 0),
    then slot bindings (1). Within each group, fewer modifiers come
    first, then lower F-key numbers."""
    kind_rank = 0 if b.get("kind") == "app" else 1
    mod = b.get("modifiers", "")
    mod_count = mod.count("+") if mod else 0
    key = b.get("key", "")
    if key.startswith("F") and key[1:].isdigit():
        fn = int(key[1:])
    else:
        fn = 99
    return (kind_rank, mod_count, fn)


def build_binding_widgets():
    widgets = []
    for a in read_app_bindings():
        try:
            anchor = int(a.get("target_window", "0"), 16)
        except ValueError:
            anchor = 0
        widgets.append({
            "shortcut": build_shortcut_label(a),
            "modifiers": a.get("modifiers", ""),
            "key": a.get("key", ""),
            "label": a.get("cmd", ""),
            "wm_class": a.get("wm_class", ""),
            "status": status_for(anchor),
            "kind": "app",
        })
    for slot in read_slot_bindings():
        try:
            anchor = int(slot.get("window_id", "0"), 16)
        except ValueError:
            anchor = 0
        widgets.append({
            "shortcut": build_shortcut_label(slot),
            "modifiers": slot.get("modifiers", ""),
            "key": slot.get("key", ""),
            "label": slot.get("window_title") or slot.get("window_class", ""),
            "wm_class": slot.get("window_class", ""),
            "status": status_for(anchor),
            "kind": "slot",
        })
    widgets.sort(key=_sort_key)
    return widgets


def make_status_decoration(status):
    if status == STATUS_STARTED:
        return "\u25cf", "wt-status-alive"
    if status == STATUS_HIDDEN:
        return "\u25cb", "wt-status-hidden"
    return "\u00b7", "wt-status-notstarted"


def build_binding_box(b):
    icon_paintable = lookup_icon_for(b["wm_class"], b["label"])
    if icon_paintable:
        img = Gtk.Image.new_from_paintable(icon_paintable)
    else:
        img = Gtk.Image.new_from_icon_name("application-x-executable")
    img.set_pixel_size(ICON_SIZE)

    inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                    halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    inner.set_margin_top(12)
    inner.set_margin_bottom(12)
    inner.set_margin_start(12)
    inner.set_margin_end(12)

    inner.append(img)

    status_glyph, css_class = make_status_decoration(b["status"])
    caption = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6,
                      halign=Gtk.Align.CENTER)
    glyph_lbl = Gtk.Label(label=status_glyph)
    glyph_lbl.add_css_class(css_class)
    glyph_lbl.add_css_class("wt-status-glyph")
    key_lbl = Gtk.Label(label=b["shortcut"])
    key_lbl.add_css_class("wt-key")
    caption.append(glyph_lbl)
    caption.append(key_lbl)
    inner.append(caption)

    name_lbl = Gtk.Label(label=b["label"])
    name_lbl.set_ellipsize(3)
    name_lbl.set_max_width_chars(20)
    name_lbl.add_css_class("wt-name")
    inner.append(name_lbl)

    if b["status"] == STATUS_HIDDEN:
        img.add_css_class("wt-dim")
    elif b["status"] == STATUS_NOT_STARTED:
        img.add_css_class("wt-dim-most")

    return inner


VIEWER_PID_PATH = "/tmp/window-toggle-viewer.pid"

def _pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False

def signal_existing_daemon():
    """If a viewer daemon is already running, send SIGUSR1 to toggle visibility.
    Returns True if a signal was sent."""
    try:
        with open(VIEWER_PID_PATH) as f:
            pid = int(f.read().strip() or "0")
    except (OSError, ValueError):
        return False
    if pid <= 0 or not _pid_alive(pid):
        return False
    try:
        os.kill(pid, signal.SIGUSR1)
        return True
    except OSError:
        return False

def main():
    if not os.path.exists(WT_BIN):
        sys.stderr.write(f"window-toggle-viewer: {WT_BIN} not found\n")
        sys.exit(1)

    # If a viewer daemon is already running, just signal it to toggle and exit.
    if signal_existing_daemon():
        sys.exit(0)

    app = Gtk.Application(application_id="org.windowtoggle.viewer", flags=0)

    state = {"win": None, "visible": False}

    def toggle_visibility(*args):
        w = state["win"]
        if w is None:
            return
        if state["visible"]:
            w.set_visible(False)
            state["visible"] = False
            return
        # About to show: re-read the config files so any binding added
        # since the last show (or since the viewer started) is reflected.
        # Cheap if mtime hasn't changed.
        current = _check_files_mtime()
        last = state.get("last_mtime", 0)
        if current != last:
            state["last_mtime"] = current
            new_bindings = build_binding_widgets()
            old_keys = [b.get("label","") + "|" + b.get("shortcut","") for b in state.get("last_bindings", [])]
            new_keys = [b.get("label","") + "|" + b.get("shortcut","") for b in new_bindings]
            if old_keys != new_keys:
                state["last_bindings"] = new_bindings
                box = state.get("hbox")
                if box is not None:
                    w2, h2 = _layout_into(box, new_bindings)
                    w.set_default_size(w2, h2)
        w.present()
        state["visible"] = True
        # Re-center on every show because mutter does not preserve
        # the previous position when a window is hidden and re-shown.
        if state.get("place_fn"):
            state["place_fn"]()
        # 弹窗打开期间，每秒重算一次每行 status，按 Ctrl+Fx 关闭窗口后
        # 弹窗内容会立刻反映新状态，而不是要关掉再开一次。
        if state.get("poll_id") is None:
            def _poll(*args):
                box = state.get("hbox")
                if box is None or not state.get("visible"):
                    return True
                changed = False
                for child in box.get_first_child(),:
                    pass  # not used; iterate below
                # 遍历子组件里的所有 binding box
                cur = box.get_first_child()
                bindings = state.get("last_bindings", [])
                bi = 0
                # 简单做法：状态变了就整体重画一次（绑定数量通常 ≤ 20，开销可忽略）
                from copy import deepcopy
                old = [(b["shortcut"], b["status"]) for b in bindings]
                new_bindings = build_binding_widgets()
                new = [(b["shortcut"], b["status"]) for b in new_bindings]
                if old != new:
                    state["last_bindings"] = new_bindings
                    w2, h2 = _layout_into(box, new_bindings)
                    w.set_default_size(w2, h2)
                return True
            state["poll_id"] = GLib.timeout_add_seconds(1, _poll)

    def on_sigusr1(signum, frame):
        # Called from GTK main loop via GLib.idle_add to be thread-safe.
        GLib.idle_add(toggle_visibility)

    def on_activate(a):
        # If a previous activate (manual or via dbus) already built the
        # window, do nothing. Otherwise we'd leak an orphan Window.
        if state.get("win") is not None:
            return
        win = Gtk.Window(application=a)
        state["win"] = win
        # Write PID file and install signal handler.
        with open(VIEWER_PID_PATH, "w") as f:
            f.write(str(os.getpid()))
        signal.signal(signal.SIGUSR1, on_sigusr1)
        win.set_title("window-toggle")
        win.set_decorated(False)
        win.set_resizable(False)

        bindings = build_binding_widgets()
        if not bindings:
            a.quit()
            return

        # 让 Alt+Tab / 任务栏 / dock 看到 window-toggle 图标。
        win.set_icon_name("window-toggle")

        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        hbox.set_homogeneous(False)
        hbox.set_margin_start(12)
        hbox.set_margin_end(12)
        hbox.set_margin_top(12)
        hbox.set_margin_bottom(12)

        width, height = _layout_into(hbox, bindings)
        win.set_child(hbox)
        win.set_default_size(width, height)
        state["place_fn"] = _center_window(win, width, height)
        state["hbox"] = hbox
        state["last_mtime"] = _check_files_mtime()
        state["last_bindings"] = bindings

        css = Gtk.CssProvider()
        css.load_from_data(b"""
            .wt-status-glyph { font-size: 18px; color: #ffffff; }

            .wt-key { font-size: 16px; font-weight: bold; color: #ffffff; }
            .wt-name { font-size: 13px; opacity: 0.8; color: #ffffff; }
            .wt-status-alive { color: #4caf50; }
            .wt-status-hidden { color: #bbbbbb; }
            .wt-status-notstarted { color: #ff9800; }
            .wt-sep { background-color: rgba(255,255,255,0.75); }
            .wt-dim { opacity: 0.4; }
            .wt-dim-more { opacity: 0.2; }
            .wt-dim-most { opacity: 0.25; }
            window { background: alpha(#1e1e1e, 0.92); color: #ffffff; border-radius: 12px; }
        """)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )


        def on_key(ctrl, keyval, keycode, state):
            # Only Escape dismisses the popup. Any other key (including
            # Ctrl+Pause / Ctrl+Fx) must fall through to gsd-media-keys
            # and the application that owns the focus, otherwise the
            # viewer would silently eat every keystroke while it's open.
            if keyval == Gdk.KEY_Escape:
                toggle_visibility()
                return True
            return False

        def on_focus_out(ctrl, *args):
            toggle_visibility()
            return False

        key = Gtk.EventControllerKey()
        key.connect("key-pressed", on_key)
        win.add_controller(key)

        focus = Gtk.EventControllerFocus()
        focus.connect("leave", on_focus_out)
        win.add_controller(focus)

        # 设 WM_CLASS 让 Alt+Tab / dock / 任务栏找到 window-toggle 图标。
        # 默认 GTK 从 argv[0] (= python3.12) 推 WM_CLASS,所以 Alt+Tab
        # 显示的是 Python 图标。XSetClassHint 改 res_name + res_class。
        try:
            gi.require_version("GdkX11", "4.0")
            from gi.repository import GdkX11
            import ctypes as _ct
            _libx11 = _ct.CDLL("libX11.so.6", use_errno=True)
            class _XClassHint(_ct.Structure):
                _fields_ = [("res_name", _ct.c_char_p),
                            ("res_class", _ct.c_char_p)]
            _libx11.XOpenDisplay.restype = _ct.c_void_p
            _libx11.XOpenDisplay.argtypes = [_ct.c_char_p]
            _libx11.XSetClassHint.restype = _ct.c_int
            _libx11.XSetClassHint.argtypes = [_ct.c_void_p, _ct.c_ulong,
                                              _ct.POINTER(_XClassHint)]
            _x11 = GdkX11.X11Display.get_default()
            _dpy = _libx11.XOpenDisplay(None)
            # res_name 和 res_class 都设成 "window-toggle",这样 mutter Alt+Tab
            # / 任务栏 / dock 按 res_class 找图标时,会找到 data/icons/hicolor/
            # apps/window-toggle.{svg,png} (用 icon 名 "window-toggle")。
            _hint = _XClassHint(b"window-toggle", b"window-toggle")
            # 拿窗口 XID: 先 realize 窗口让 surface 存在
            win.realize()
            _surface = win.get_surface()
            if _surface is not None:
                _xid = GdkX11.X11Surface.get_xid(_surface)
                _libx11.XSetClassHint(_dpy, _xid, _ct.byref(_hint))
                _libx11.XFlush(_dpy)
        except Exception as _e:
            sys.stderr.write(f"window-toggle-viewer: WM_CLASS set failed: {_e}\n")

        # Do not flip state["visible"] to True here. The window is just
        # presented by on_activate, but if a stale SIGUSR1 (queued up
        # before the daemon was ready, or fired by the gsd-media-keys
        # "key release" handler on the same physical press that started
        # us) reaches toggle_visibility right after this point, we want
        # it to land on the "show" branch, not "hide". Leaving visible
        # False means the first toggle after startup is always a show.

        def on_destroy(*args):
            try:
                os.unlink(VIEWER_PID_PATH)
            except OSError:
                pass

        win.connect("destroy", on_destroy)
        win.present()

    def on_sigterm(signum, frame):
        app.quit()

    signal.signal(signal.SIGTERM, on_sigterm)

    app.connect("activate", on_activate)
    # Defer the first activation to the GTK main loop's idle phase so the
    # GApplication::startup signal has been emitted. Calling on_activate
    # directly here (or before app.run) hits "Gtk-CRITICAL: New application
    # windows must be added after the GApplication::startup signal has been
    # emitted", and the GtkApplication state machine is left in a half-
    # initialized state where app.run([]) returns immediately, which is
    # why the viewer process used to die right after startup.
    GLib.idle_add(on_activate, app)
    try:
        app.run([])
    finally:
        try:
            os.unlink(VIEWER_PID_PATH)
        except OSError:
            pass


if __name__ == "__main__":
    main()
